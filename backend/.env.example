# Variables del servicio de predicción.
# Copie este archivo a .env y ajuste los valores. El .env no se sube al repo.

# Dominios que pueden llamar a la API, separados por coma.
# En producción tiene que estar el dominio de la aplicación web.
GRILLOSIA_ALLOWED_ORIGINS=http://localhost:3000,https://grilliaa.vercel.app

# Dónde está el modelo entrenado. Solo hace falta si no está en el sitio
# de siempre (backend/ml/modelo.joblib).
# GRILLOSIA_MODEL_PATH=backend/ml/modelo.joblib

# PostgreSQL, para guardar el histórico de lotes de la plantilla.
# El servicio de predicción no la necesita para responder.
# DATABASE_URL=postgresql://usuario:clave@host:5432/grillia
