# Variables de la aplicación web.
# Copie este archivo a .env.local y ajuste los valores.

# Dirección del servicio de predicción. Si se deja vacía, la aplicación
# funciona igual: el resultado muestra "por confirmar" en lugar de números.
# En local, con el servicio corriendo: http://localhost:8000
NEXT_PUBLIC_API_URL=

# Dominio publico. Sin esto, las vistas previas al compartir por WhatsApp
# no resuelven bien las rutas.
NEXT_PUBLIC_SITE_URL=https://grillosia.com

# ── Asistente ───────────────────────────────────────────────────────
# Sin llave, el chat sigue funcionando con las respuestas guionadas.
OPENAI_API_KEY=
# Modelo. Por defecto gpt-5.4-nano: es el mas barato que pasa las pruebas
# de lenguaje protegido y acierta la llamada a la herramienta.
# OPENAI_MODEL=gpt-5.4-nano

# ── Voz ─────────────────────────────────────────────────────────────
# Lectura en voz alta de las respuestas. Sin llave, el chat sigue
# funcionando: lee con la voz del navegador, que suena peor pero no
# deja a nadie sin oir. El dictado no necesita llave: usa el
# reconocimiento nativo del navegador.
ELEVENLABS_API_KEY=
# Voz a usar. Por defecto una multilingue de ElevenLabs.
# ELEVENLABS_VOICE_ID=

# ── Cuentas (opcional) ──────────────────────────────────────────────
# Con esto en falso la aplicación guarda las consultas solo en el
# dispositivo. En verdadero, pide iniciar sesión con Google.
NEXT_PUBLIC_ENABLE_AUTH=false

# Credenciales de Google (Google Cloud Console → Credenciales → ID de
# cliente de OAuth). Solo hacen falta si NEXT_PUBLIC_ENABLE_AUTH=true.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Cadena aleatoria para firmar las sesiones. Genérela con:
#   openssl rand -base64 32
AUTH_SECRET=

# PostgreSQL donde se guardan las cuentas y las consultas.
# En Railway: pestaña Variables del servicio Postgres → DATABASE_URL.
DATABASE_URL=
